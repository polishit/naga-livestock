# ---- docker-compose.yml (production) ----
# Public hostname; Caddy fetches a Let's Encrypt certificate for it automatically.
DOMAIN=livestock.example.gov.ph
ACME_EMAIL=it@example.gov.ph

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Uploads. Defaults use the bundled MinIO. For AWS S3 set S3_ENDPOINT empty and S3_FORCE_PATH_STYLE=false;
# for Cloudflare R2 use https://<account>.r2.cloudflarestorage.com and S3_REGION=auto.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=livestock
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true

# Error tracking (optional)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Set by CI deploys to use the images pushed to GHCR
# API_IMAGE=ghcr.io/<owner>/naga-livestock-api:latest
# WEB_IMAGE=ghcr.io/<owner>/naga-livestock-web:latest
