{
  "name": "naga-livestock",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Naga City Livestock Monitoring System with GIS Integration",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @livestock/api --filter @livestock/web dev",
    "build": "pnpm -r --filter @livestock/shared --filter @livestock/api --filter @livestock/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @livestock/api db:migrate",
        "db:seed": "pnpm --filter @livestock/api db:seed",
    "db:seed:empty": "pnpm --filter @livestock/api db:seed:empty",
    "db:reset": "pnpm --filter @livestock/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@playwright/test": "1.56.1",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.13.0",
    "prettier": "3.4.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.17.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
