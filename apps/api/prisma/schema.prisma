// Naga City Livestock Monitoring System — MySQL 8 schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7). The runtime uses the MariaDB driver adapter.
datasource db {
  provider = "mysql"
}

/// ADMIN = System Administrator, VETERINARIAN = reviewer, TECHNICIAN = field technician,
/// OWNER = livestock owner (owner app only; sees only their own records)
enum Role {
  ADMIN
  VETERINARIAN
  TECHNICIAN
  OWNER
}

/// Accounts are never deleted: they are suspended (temporary) or deactivated (left the office).
enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// PENDING = registered by the owner in the owner app, waiting for the CVO to verify.
/// ACTIVE = verified. INACTIVE / ARCHIVED = retired (never deleted).
enum OwnerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  PENDING
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DECEASED
  MISSING
  SLAUGHTERED
  /// Registered by mistake: kept and marked, never deleted
  VOIDED
}

/// Set automatically from the case's laboratory samples (see deriveCaseStatus in packages/shared).
enum CaseStatus {
  SUSPECTED
  SAMPLE_COLLECTED
  SENT_TO_LAB
  POSITIVE
  NEGATIVE
}

enum LabResult {
  PENDING
  POSITIVE
  NEGATIVE
  INCONCLUSIVE
}

enum StrayStatus {
  REPORTED
  CLOSED
}

enum TransferType {
  TRANSFER
  REVERSAL
}

enum VaccinationTarget {
  GROUP
  ANIMAL
}

model User {
  id                 Int            @id @default(autoincrement())
  email              String         @unique @db.VarChar(191)
  name               String         @db.VarChar(120)
  title              String?        @db.VarChar(120)
  role               Role           @default(TECHNICIAN)
  passwordHash       String         @db.VarChar(100)
  status             UserStatus     @default(ACTIVE)
  /// A temporary password (set by the administrator) must be changed at the next sign-in
  mustChangePassword Boolean        @default(false)
  passwordChangedAt  DateTime?
  /// Wrong passwords in a row; the account locks when it reaches the limit in the settings
  failedLogins       Int            @default(0)
  lockedUntil        DateTime?
  /// The owner record this login belongs to (role OWNER only)
  ownerId            Int?           @unique
  /// Mobile number an owner can sign in with (digits only, 09…)
  phone              String?        @unique @db.VarChar(20)
  /// Notification types the owner turned off (optional ones only)
  notifPrefs         Json?
  notifications      Notification[]
  owner              Owner?         @relation(fields: [ownerId], references: [id])
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  refreshTokens      RefreshToken[]
  assignedCases      DiseaseCase[]  @relation("AssignedInspector")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Owner {
  id                Int                 @id @default(autoincrement())
  code              String              @unique @db.VarChar(20)
  fullName          String              @db.VarChar(150)
  barangay          String              @db.VarChar(60)
  zone              String?             @db.VarChar(60)
  street            String?             @db.VarChar(200)
  contact           String?             @db.VarChar(40)
  rsbsa             String?             @db.VarChar(60)
  /// Where the office got the record: DA_LIST, FARM_VISIT, BARANGAY, OTHER
  source            String?             @db.VarChar(20)
  remarks           String?             @db.Text
  status            OwnerStatus         @default(ACTIVE)
  registeredAt      DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  farms             Farm[]
  cases             DiseaseCase[]
  strays            StrayIncident[]
  transfersOut      OwnershipTransfer[] @relation("FromOwner")
  transfersIn       OwnershipTransfer[] @relation("ToOwner")
  pcicPolicies      PcicPolicy[]
  account           User?
  email             String?             @db.VarChar(120)
  /// Registered by the owner (owner app) instead of encoded by staff
  selfRegistered    Boolean             @default(false)
  /// Why the registration was returned for correction (cleared when resubmitted)
  returnReason      String?             @db.VarChar(300)
  reviewedBy        String?             @db.VarChar(120)
  reviewedAt        DateTime?
  farmRegistrations FarmRegistration[]
  diseaseReports    DiseaseReport[]
  messages          OwnerMessage[]
  /// Valid ID sent for verification (owner app): type, number and photo keys (front, back)
  idType            String?             @db.VarChar(40)
  idNumber          String?             @db.VarChar(60)
  idPhotoKeys       Json?
  /// When the registration was last sent (or sent again) for review
  submittedAt       DateTime?
  /// What the reviewer confirmed before verifying (checklist item codes)
  verifyChecklist   Json?

  @@index([barangay])
}

/// Livestock mortality insurance: the office keeps the scanned PCIC application (the policy itself is PCIC's).
model PcicPolicy {
  id              Int       @id @default(autoincrement())
  ownerId         Int
  /// Older records only (policy details are no longer entered)
  policyNo        String?   @db.VarChar(60)
  species         String    @db.VarChar(40)
  heads           Int?
  amountCovered   Decimal?  @db.Decimal(12, 2)
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  /// Date of the PCIC application
  applicationDate DateTime? @db.Date
  /// NEW or RENEWAL
  applicationType String?   @db.VarChar(10)
  /// Premium subsidized through RSBSA
  subsidized      Boolean   @default(false)
  rsbsaRef        String?   @db.VarChar(60)
  /// Scanned application form (storage keys)
  fileKeys        Json?
  status          String    @default("ACTIVE") @db.VarChar(20)
  remarks         String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  owner           Owner     @relation(fields: [ownerId], references: [id])
  /// The tagged animals (ear tags) this policy insures
  animals         Animal[]  @relation("PcicInsuredAnimals")
}

model Farm {
  id              Int               @id @default(autoincrement())
  code            String            @unique @db.VarChar(20)
  name            String            @db.VarChar(150)
  ownerId         Int
  type            String            @db.VarChar(20)
  barangay        String            @db.VarChar(60)
  zone            String?           @db.VarChar(60)
  address         String?           @db.VarChar(250)
  pastureArea     Float?
  /// Where the animals graze when the pasture is away from the farm
  pastureLocation String?           @db.VarChar(250)
  pastureLat      Float?
  pastureLng      Float?
  lat             Float?
  lng             Float?
  /// Where the office got the record: DA_LIST, FARM_VISIT, BARANGAY, OTHER
  source          String?           @db.VarChar(20)
  remarks         String?           @db.Text
  archived        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           Owner             @relation(fields: [ownerId], references: [id])
  groups          PopulationGroup[]
  cases           DiseaseCase[]
  vaccinations    Vaccination[]
  visits          FarmVisit[]
  labSamples      LabRecord[]

  @@index([barangay])
  @@index([ownerId])
}

model PopulationGroup {
  id           Int                @id @default(autoincrement())
  code         String             @unique @db.VarChar(20)
  farmId       Int
  species      String             @db.VarChar(40)
  breed        String?            @db.VarChar(80)
  sex          String             @default("Mixed") @db.VarChar(20)
  count        Int                @default(0)
  healthStatus String             @default("Healthy") @db.VarChar(40)
  /// Cattle and carabao: DRAFT, DAIRY, FATTENING, BREEDING (as on the PCIC application)
  purpose      String?            @db.VarChar(20)
  remarks      String?            @db.VarChar(500)
  lastVerified String?            @db.VarChar(7) // YYYY-MM of the latest verified update
  archived     Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  farm         Farm               @relation(fields: [farmId], references: [id])
  animals      Animal[]
  updates      PopulationUpdate[]
  vaccinations Vaccination[]

  @@index([farmId])
  @@index([species])
}

/// One row per group per reporting month. Re-saving a month marks the earlier row superseded.
model PopulationUpdate {
  id         Int             @id @default(autoincrement())
  groupId    Int
  month      String          @db.VarChar(7)
  count      Int
  previous   Int?
  change     Int             @default(0)
  reason     String?         @db.VarChar(200)
  /// VERIFIED = monthly count by staff; ADJUSTMENT = automatic change (transfer, death, sale)
  kind       String          @default("VERIFIED") @db.VarChar(20)
  superseded Boolean         @default(false)
  createdBy  String?         @db.VarChar(120)
  createdAt  DateTime        @default(now())
  group      PopulationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, month])
}

model Animal {
  id           Int                 @id @default(autoincrement())
  code         String              @unique @db.VarChar(20)
  earTag       String?             @unique @db.VarChar(40)
  groupId      Int
  species      String              @db.VarChar(40)
  breed        String?             @db.VarChar(80)
  sex          String              @db.VarChar(10)
  dob          DateTime?           @db.Date
  estimatedAge String?             @db.VarChar(40)
  lifeStage    String?             @db.VarChar(40)
  markings     String?             @db.VarChar(200)
  cowlick      String?             @db.VarChar(200)
  /// Cattle and carabao: DRAFT, DAIRY, FATTENING, BREEDING
  purpose      String?             @db.VarChar(20)
  /// Certificate of Ownership of Large Cattle (cattle and carabao)
  colcNo       String?             @db.VarChar(60)
  colcDate     DateTime?           @db.Date
  /// Scanned certificate (storage keys)
  colcFileKeys Json?
  health       String?             @db.VarChar(80)
  photoKeys    Json?
  remarks      String?             @db.VarChar(500)
  status       AnimalStatus        @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  group        PopulationGroup     @relation(fields: [groupId], references: [id])
  transfers    OwnershipTransfer[]
  vaccinations Vaccination[]
  pcicPolicies PcicPolicy[]        @relation("PcicInsuredAnimals")

  @@index([groupId])
}

model OwnershipTransfer {
  id          Int          @id @default(autoincrement())
  code        String       @unique @db.VarChar(20)
  animalId    Int
  fromOwnerId Int
  fromFarmId  Int
  toOwnerId   Int
  toFarmId    Int
  date        DateTime     @db.Date
  type        TransferType @default(TRANSFER)
  remarks     String?      @db.VarChar(300)
  createdBy   String?      @db.VarChar(120)
  createdAt   DateTime     @default(now())
  animal      Animal       @relation(fields: [animalId], references: [id])
  fromOwner   Owner        @relation("FromOwner", fields: [fromOwnerId], references: [id])
  toOwner     Owner        @relation("ToOwner", fields: [toOwnerId], references: [id])
}

model StrayIncident {
  id            Int         @id @default(autoincrement())
  code          String      @unique @db.VarChar(20)
  discoveredAt  DateTime
  species       String      @db.VarChar(40)
  earTag        String?     @db.VarChar(40)
  animalId      Int?
  ownerId       Int?
  barangay      String      @db.VarChar(60)
  location      String      @db.VarChar(200)
  description   String?     @db.Text
  lat           Float?
  lng           Float?
  photoKeys     Json?
  status        StrayStatus @default(REPORTED)
  violations    Int         @default(0)
  violationType String?     @db.VarChar(80)
  /// Impoundment and release (no longer used; kept so older records are not lost)
  impoundedAt   DateTime?   @db.Date
  impoundPlace  String?     @db.VarChar(200)
  releasedAt    DateTime?   @db.Date
  releasedTo    String?     @db.VarChar(150)
  remarks       String?     @db.Text
  /// Voided: reported in error or a duplicate. Kept for history, left out of every figure.
  voidedAt      DateTime?
  voidedBy      String?     @db.VarChar(120)
  voidReason    String?     @db.VarChar(300)
  createdBy     String?     @db.VarChar(120)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  owner         Owner?      @relation(fields: [ownerId], references: [id])
}

model DiseaseCase {
  id                   Int                 @id @default(autoincrement())
  code                 String              @unique @db.VarChar(20)
  ownerId              Int
  farmId               Int
  barangay             String              @db.VarChar(60)
  zone                 String?             @db.VarChar(60)
  species              String              @db.VarChar(40)
  disease              String              @db.VarChar(150)
  affected             Int
  deaths               Int                 @default(0)
  symptomsDate         DateTime?           @db.Date
  reportedAt           DateTime            @db.Date
  symptoms             String?             @db.Text
  /// Clinical signs observed (codes from CLINICAL_SIGNS)
  clinicalSigns        Json?
  reportedBy           String?             @db.VarChar(120)
  assignedToId         Int?
  sampleInfo           String?             @db.VarChar(300)
  remarks              String?             @db.Text
  lat                  Float?
  lng                  Float?
  locationSource       String?             @db.VarChar(40)
  photoKeys            Json?
  status               CaseStatus          @default(SUSPECTED)
  closedAt             DateTime?
  closedBy             String?             @db.VarChar(120)
  closureNote          String?             @db.Text
  /// How the case ended (RESOLVED, CONTAINED, DEPOPULATED, NOT_CONFIRMED, OTHER)
  closureOutcome       String?             @db.VarChar(40)
  relatedCaseId        Int?
  /// Deaths + culled heads already reflected in the farm's population
  populationReconciled Int                 @default(0)
  /// Voided: reported in error or a duplicate. Kept for history, left out of every figure.
  voidedAt             DateTime?
  voidedBy             String?             @db.VarChar(120)
  voidReason           String?             @db.VarChar(300)
  relatedCase          DiseaseCase?        @relation("LinkedCases", fields: [relatedCaseId], references: [id])
  linkedCases          DiseaseCase[]       @relation("LinkedCases")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  owner                Owner               @relation(fields: [ownerId], references: [id])
  farm                 Farm                @relation(fields: [farmId], references: [id])
  assignedTo           User?               @relation("AssignedInspector", fields: [assignedToId], references: [id])
  history              CaseStatusHistory[]
  investigations       Investigation[]
  labRecords           LabRecord[]
  responses            ResponseActivity[]
  monitoringVisits     FarmVisit[]

  @@index([status])
  @@index([barangay])
}

model CaseStatusHistory {
  id     Int         @id @default(autoincrement())
  caseId Int
  status CaseStatus
  note   String?     @db.VarChar(500)
  byName String?     @db.VarChar(120)
  at     DateTime    @default(now())
  case   DiseaseCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Investigation {
  id               Int         @id @default(autoincrement())
  caseId           Int
  date             DateTime    @db.Date
  investigator     String?     @db.VarChar(120)
  /// INITIAL, FOLLOW_UP, TRACING, FINAL
  visitType        String      @default("INITIAL") @db.VarChar(30)
  animalsExamined  Int?
  sickCount        Int?
  deadCount        Int?
  clinicalSigns    String?     @db.Text
  biosecurity      String?     @db.Text
  actionsTaken     String?     @db.Text
  samplesCollected Boolean     @default(false)
  nextVisit        DateTime?   @db.Date
  notes            String      @db.Text
  voidedAt         DateTime?
  voidedBy         String?     @db.VarChar(120)
  voidReason       String?     @db.VarChar(300)
  createdAt        DateTime    @default(now())
  case             DiseaseCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

/// A laboratory sample: taken for a disease case, or in routine surveillance (sent as a batch, see LabSubmission).
model LabRecord {
  id              Int            @id @default(autoincrement())
  /// The disease case, if any (routine surveillance samples have none until one comes back positive)
  caseId          Int?
  /// Batch the sample was sent in (Analysis Request + Sample Collection forms)
  submissionId    Int?
  /// Where the sample came from (always set; a case sample uses the case's farm)
  farmId          Int?
  species         String?        @db.VarChar(40)
  /// As on the Sample Collection Form, e.g. "3 m", "1 yr"
  animalAge       String?        @db.VarChar(20)
  /// M or F
  animalSex       String?        @db.VarChar(1)
  /// LIVE or DEAD (a dead animal gives organ samples)
  condition       String?        @db.VarChar(10)
  hoursSinceDeath Int?
  /// Organs taken (tissue samples): spleen, lymph node, liver…
  organs          String?        @db.VarChar(120)
  /// How the result arrived: EMAIL, HARD_COPY, PHONE, OTHER
  receivedVia     String?        @db.VarChar(20)
  sampleId        String         @db.VarChar(60)
  sampleType      String?        @db.VarChar(80)
  sampleCount     Int?
  testMethod      String?        @db.VarChar(80)
  collectedAt     DateTime?      @db.Date
  laboratory      String?        @db.VarChar(120)
  labReference    String?        @db.VarChar(60)
  submittedBy     String?        @db.VarChar(120)
  sentAt          DateTime?      @db.Date
  result          LabResult      @default(PENDING)
  resultDate      DateTime?      @db.Date
  remarks         String?        @db.VarChar(500)
  voidedAt        DateTime?
  voidedBy        String?        @db.VarChar(120)
  voidReason      String?        @db.VarChar(300)
  updatedAt       DateTime?
  updatedBy       String?        @db.VarChar(120)
  createdAt       DateTime       @default(now())
  case            DiseaseCase?   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submission      LabSubmission? @relation(fields: [submissionId], references: [id])
  farm            Farm?          @relation(fields: [farmId], references: [id])

  @@index([submissionId])
  @@index([farmId])
}

/// One batch of samples sent to the laboratory: printed as the Analysis Request Form and the
/// Laboratory Sample Collection Form.
model LabSubmission {
  id          Int         @id @default(autoincrement())
  code        String      @unique @db.VarChar(20)
  /// SURVEILLANCE, DISEASE_INVESTIGATION, LOCAL_SHIPMENT, DIAGNOSTICS, REGULATORY, FARM_ACCREDITATION, OTHER
  purpose     String      @db.VarChar(30)
  /// Examination requested, e.g. "PCR – African Swine Fever (ASF)"
  examination String      @db.VarChar(120)
  laboratory  String      @db.VarChar(120)
  /// Date the samples were submitted to the laboratory
  submittedAt DateTime?   @db.Date
  submittedBy String?     @db.VarChar(120)
  notedBy     String?     @db.VarChar(120)
  /// Request ID and accession number given by the laboratory
  requestId   String?     @db.VarChar(60)
  accessionNo String?     @db.VarChar(60)
  remarks     String?     @db.Text
  createdBy   String?     @db.VarChar(120)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  samples     LabRecord[]

  @@index([submittedAt])
}

model ResponseActivity {
  id             Int         @id @default(autoincrement())
  caseId         Int
  type           String      @db.VarChar(40)
  /// PLANNED, ONGOING, COMPLETED
  status         String      @default("COMPLETED") @db.VarChar(20)
  date           DateTime    @db.Date
  /// When the measure ends or is lifted
  endDate        DateTime?   @db.Date
  location       String?     @db.VarChar(200)
  personnel      String?     @db.VarChar(200)
  remarks        String?     @db.Text
  /// Number of animals culled (CULLING responses)
  heads          Int?
  disposalMethod String?     @db.VarChar(80)
  voidedAt       DateTime?
  voidedBy       String?     @db.VarChar(120)
  voidReason     String?     @db.VarChar(300)
  createdAt      DateTime    @default(now())
  case           DiseaseCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Vaccination {
  id             Int               @id @default(autoincrement())
  code           String            @unique @db.VarChar(20)
  farmId         Int
  target         VaccinationTarget @default(GROUP)
  groupId        Int?
  animalId       Int?
  species        String            @db.VarChar(40)
  count          Int
  /// DEWORMING, VACCINATION, CHECKUP, PREGNANCY_DIAGNOSIS, INSEMINATION, TREATMENT, OTHER
  serviceType    String            @default("VACCINATION") @db.VarChar(20)
  /// Vaccine, dewormer or medicine used (required for vaccinations only); semen / bull for insemination
  vaccine        String?           @db.VarChar(120)
  /// Pregnancy diagnosis: PREGNANT or NOT_PREGNANT
  result         String?           @db.VarChar(20)
  date           DateTime          @db.Date
  nextDate       DateTime?         @db.Date
  doseNumber     Int               @default(1)
  batch          String?           @db.VarChar(60)
  administeredBy String?           @db.VarChar(120)
  remarks        String?           @db.VarChar(500)
  /// The next-dose reminder was fulfilled by a later vaccination
  reminderDone   Boolean           @default(false)
  voidedAt       DateTime?
  voidedBy       String?           @db.VarChar(120)
  voidReason     String?           @db.VarChar(300)
  createdAt      DateTime          @default(now())
  farm           Farm              @relation(fields: [farmId], references: [id])
  group          PopulationGroup?  @relation(fields: [groupId], references: [id])
  animal         Animal?           @relation(fields: [animalId], references: [id])

  @@index([date])
  @@index([serviceType])
}

/// A field visit to a farm: routine masterlist update, deworming, check-up, or monitoring near a disease case.
model FarmVisit {
  id         Int          @id @default(autoincrement())
  code       String       @unique @db.VarChar(20)
  farmId     Int
  /// The disease case this visit monitors (farms near a reported case)
  caseId     Int?
  date       DateTime     @db.Date
  /// ROUTINE, DEWORMING, CHECKUP, MONITORING, OTHER
  purpose    String       @db.VarChar(20)
  /// NO_SIGNS, SICK_ANIMALS
  findings   String       @default("NO_SIGNS") @db.VarChar(20)
  visitedBy  String?      @db.VarChar(120)
  remarks    String?      @db.Text
  createdBy  String?      @db.VarChar(120)
  /// Entered in error: kept and marked, never deleted
  voidedAt   DateTime?
  voidedBy   String?      @db.VarChar(120)
  voidReason String?      @db.VarChar(300)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  farm       Farm         @relation(fields: [farmId], references: [id])
  case       DiseaseCase? @relation(fields: [caseId], references: [id])

  @@index([farmId])
  @@index([caseId])
  @@index([date])
}

/// Audit trail: powers "Recent activity", record history tabs and notifications.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  entity    String   @db.VarChar(40)
  entityId  Int
  action    String   @db.VarChar(40)
  summary   String   @db.VarChar(300)
  byName    String?  @db.VarChar(120)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Field-level audit trail: one row per create, change or security event, with the old and new
/// values. Rows are never edited or deleted (the database refuses, see lib/audit.ts).
model AuditEntry {
  id        Int      @id @default(autoincrement())
  /// The table (model) and the record changed
  tableName String   @db.VarChar(40)
  recordId  String   @db.VarChar(60)
  /// CREATE, UPDATE, LOGIN, LOGIN_FAILED, LOCKED, PASSWORD_CHANGED, PASSWORD_RESET, LOGOUT, EXPORT
  action    String   @db.VarChar(30)
  /// { field: [old, new] } for an update; the new values for a create
  changes   Json?
  note      String?  @db.VarChar(300)
  userId    Int?
  byName    String?  @db.VarChar(120)
  /// web (CVO system), owner (owner app) or system (automatic)
  source    String   @default("web") @db.VarChar(20)
  createdAt DateTime @default(now())

  @@index([tableName, recordId])
  @@index([createdAt])
  @@index([userId])
}

model Setting {
  key   String @id @db.VarChar(60)
  value String @db.Text
}

/// A farm registered by its owner in the owner app. It becomes a real Farm (with its livestock
/// groups) only when the CVO approves it, so pending farms never enter the map or the figures.
model FarmRegistration {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(20)
  ownerId         Int
  name            String    @db.VarChar(150)
  type            String    @db.VarChar(20)
  barangay        String    @db.VarChar(60)
  zone            String?   @db.VarChar(60)
  address         String?   @db.VarChar(250)
  lat             Float?
  lng             Float?
  /// Accuracy of the phone GPS reading in metres (null when the pin was placed by hand)
  gpsAccuracy     Float?
  /// [{ species, count }] declared by the owner
  livestock       Json
  /// PENDING, RETURNED (for correction), APPROVED, INACTIVE (not accepted)
  status          String    @default("PENDING") @db.VarChar(20)
  returnReason    String?   @db.VarChar(300)
  reviewedBy      String?   @db.VarChar(120)
  reviewedAt      DateTime?
  /// The farm created when the registration was approved
  farmId          Int?
  /// What the reviewer confirmed before verifying (checklist item codes)
  verifyChecklist Json?
  submittedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  owner           Owner     @relation(fields: [ownerId], references: [id])

  @@index([status])
  @@index([ownerId])
}

/// A head count change sent by the owner (birth, purchase, sale, death…). Normal changes are
/// accepted automatically; unusually large ones are flagged for a reviewer.
model PopulationRequest {
  id           Int       @id @default(autoincrement())
  ownerId      Int
  farmId       Int
  groupId      Int?
  species      String    @db.VarChar(40)
  /// BIRTH, PURCHASE, SALE, DEATH, SLAUGHTER, LOST, CORRECTION
  reason       String    @db.VarChar(20)
  /// Signed change in head (+ added, − removed)
  quantity     Int
  before       Int
  after        Int
  note         String?   @db.VarChar(300)
  /// PENDING, ACCEPTED, CANCELLED
  status       String    @default("PENDING") @db.VarChar(20)
  flagged      Boolean   @default(false)
  flagReason   String?   @db.VarChar(200)
  /// "System" when accepted automatically
  decidedBy    String?   @db.VarChar(120)
  decidedAt    DateTime?
  decisionNote String?   @db.VarChar(300)
  createdBy    String?   @db.VarChar(120)
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([farmId])
  @@index([ownerId])
}

/// A suspected disease reported by the owner from the owner app. The CVO validates it (a disease
/// case is opened), asks for more information, or rejects it with a reason.
model DiseaseReport {
  id               Int             @id @default(autoincrement())
  code             String          @unique @db.VarChar(20)
  ownerId          Int
  farmId           Int
  species          String          @db.VarChar(40)
  symptoms         String          @db.Text
  signs            Json?
  affected         Int
  deaths           Int             @default(0)
  observedAt       DateTime        @db.Date
  photoKeys        Json?
  lat              Float?
  lng              Float?
  gpsAccuracy      Float?
  /// PHONE_GPS or FARM (GPS off or refused: the farm's own location is used)
  locationSource   String          @db.VarChar(20)
  /// Metres between the phone and the farm when the report was sent
  distanceFromFarm Int?
  /// REPORTED, INFO_REQUESTED, VALIDATED, REJECTED
  status           String          @default("REPORTED") @db.VarChar(20)
  rejectReason     String?         @db.VarChar(300)
  /// The reviewer's own assessment when deciding (not shown to the owner)
  assessment       String?         @db.Text
  /// Planned date of the field visit (set when the report is validated)
  visitDate        DateTime?       @db.Date
  /// The disease case opened (or linked) when the report was validated
  caseId           Int?
  reviewedBy       String?         @db.VarChar(120)
  reviewedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  owner            Owner           @relation(fields: [ownerId], references: [id])
  messages         ReportMessage[]

  @@index([status])
  @@index([ownerId])
  @@index([farmId])
}

/// The conversation on a report: the CVO asks for more information, the owner replies.
model ReportMessage {
  id        Int           @id @default(autoincrement())
  reportId  Int
  fromOwner Boolean
  byName    String        @db.VarChar(120)
  text      String        @db.Text
  photoKeys Json?
  createdAt DateTime      @default(now())
  report    DiseaseReport @relation(fields: [reportId], references: [id])

  @@index([reportId])
}

/// The owner's in-app inbox. One row per message to one owner login.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  /// REGISTRATION, POPULATION, REPORT, ALERT, VACCINATION, ANNOUNCEMENT, SERVICE
  type      String    @db.VarChar(20)
  title     String    @db.VarChar(160)
  body      String    @db.Text
  /// Where in the owner app the notification opens
  link      String?   @db.VarChar(120)
  /// Set to avoid sending the same notification twice (for example a reminder)
  refKey    String?   @db.VarChar(80)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, refKey])
  @@index([userId, readAt])
}

/// A message between a livestock owner and the City Veterinary Office (the owner's Messages thread).
/// The owner sees staff replies as coming from the office; staff see who wrote them.
model OwnerMessage {
  id        Int       @id @default(autoincrement())
  ownerId   Int
  fromOwner Boolean
  /// The owner's name, or the staff member who replied
  byName    String    @db.VarChar(120)
  byUserId  Int?
  text      String    @db.Text
  photoKeys Json?
  /// When the other side read it
  readAt    DateTime?
  createdAt DateTime  @default(now())
  owner     Owner     @relation(fields: [ownerId], references: [id])

  @@index([ownerId, createdAt])
  @@index([fromOwner, readAt])
}

/// An epicenter with a monitoring radius, set by the CVO for a confirmed case. Owners of the farms
/// inside it are notified. Active until lifted; never deleted.
model MonitoringZone {
  id         Int       @id @default(autoincrement())
  code       String    @unique @db.VarChar(20)
  caseId     Int?
  disease    String    @db.VarChar(150)
  barangay   String    @db.VarChar(60)
  lat        Float
  lng        Float
  radiusM    Int
  /// ACTIVE or LIFTED
  status     String    @default("ACTIVE") @db.VarChar(20)
  guidance   String?   @db.Text
  createdBy  String?   @db.VarChar(120)
  createdAt  DateTime  @default(now())
  liftedBy   String?   @db.VarChar(120)
  liftedAt   DateTime?
  liftReason String?   @db.VarChar(300)
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

/// A vaccination activity scheduled by the CVO for a barangay.
model VaccinationActivity {
  id           Int              @id @default(autoincrement())
  code         String           @unique @db.VarChar(20)
  title        String           @db.VarChar(160)
  vaccine      String?          @db.VarChar(120)
  /// A species, or "All"
  species      String           @db.VarChar(40)
  /// A barangay, or "ALL"
  barangay     String           @db.VarChar(60)
  date         DateTime         @db.Date
  time         String?          @db.VarChar(40)
  venue        String?          @db.VarChar(200)
  notes        String?          @db.Text
  /// SCHEDULED, ONGOING, COMPLETED, CANCELLED
  status       String           @default("SCHEDULED") @db.VarChar(20)
  cancelReason String?          @db.VarChar(300)
  createdBy    String?          @db.VarChar(120)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  signups      ActivitySignup[]

  @@index([date])
  @@index([status])
}

/// An owner signing animals up for a vaccination activity.
model ActivitySignup {
  id            Int                 @id @default(autoincrement())
  activityId    Int
  ownerId       Int
  farmId        Int
  species       String              @db.VarChar(40)
  heads         Int
  /// SIGNED_UP, ATTENDED, NO_SHOW, CANCELLED
  status        String              @default("SIGNED_UP") @db.VarChar(20)
  /// The official vaccination record made when attendance was confirmed
  vaccinationId Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  activity      VaccinationActivity @relation(fields: [activityId], references: [id])

  @@unique([activityId, farmId, species])
  @@index([ownerId])
}

/// A vaccination given outside a CVO activity (for example by a private veterinarian), submitted by
/// the owner with proof. It becomes an official record only when the CVO verifies it.
model OwnerVaccination {
  id            Int       @id @default(autoincrement())
  ownerId       Int
  farmId        Int
  species       String    @db.VarChar(40)
  vaccine       String    @db.VarChar(120)
  date          DateTime  @db.Date
  heads         Int
  givenBy       String    @db.VarChar(120)
  proofKeys     Json?
  /// SUBMITTED, VERIFIED, REJECTED
  status        String    @default("SUBMITTED") @db.VarChar(20)
  reason        String?   @db.VarChar(300)
  vaccinationId Int?
  decidedBy     String?   @db.VarChar(120)
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([ownerId])
}

/// A veterinary service requested by an owner.
model ServiceRequest {
  id            Int       @id @default(autoincrement())
  code          String    @unique @db.VarChar(20)
  ownerId       Int
  farmId        Int
  serviceType   String    @db.VarChar(20)
  species       String?   @db.VarChar(40)
  note          String?   @db.VarChar(500)
  preferredDate DateTime? @db.Date
  /// REQUESTED, SCHEDULED, DONE, DECLINED
  status        String    @default("REQUESTED") @db.VarChar(20)
  scheduledDate DateTime? @db.Date
  /// Time window of the visit, as told to the owner (e.g. "9:00 AM to 11:00 AM")
  scheduledTime String?   @db.VarChar(40)
  response      String?   @db.VarChar(300)
  handledBy     String?   @db.VarChar(120)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([ownerId])
}

/// An announcement or advisory published by the CVO to owners.
model Announcement {
  id             Int       @id @default(autoincrement())
  code           String    @unique @db.VarChar(20)
  title          String    @db.VarChar(160)
  body           String    @db.Text
  /// ALL, BARANGAY or ZONE
  audience       String    @db.VarChar(20)
  barangay       String?   @db.VarChar(60)
  zoneId         Int?
  /// PUBLISHED or WITHDRAWN
  status         String    @default("PUBLISHED") @db.VarChar(20)
  recipients     Int       @default(0)
  publishedBy    String?   @db.VarChar(120)
  publishedAt    DateTime  @default(now())
  withdrawnBy    String?   @db.VarChar(120)
  withdrawnAt    DateTime?
  withdrawReason String?   @db.VarChar(300)

  @@index([status])
}
