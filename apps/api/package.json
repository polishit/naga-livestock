{
  "name": "@livestock/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/src/index.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
        "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:empty": "tsx --env-file-if-exists=.env prisma/seed.ts --empty",
    "db:reset": "prisma migrate reset --force",
    "generate": "prisma generate",
    "db:seed:prod": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@livestock/shared": "workspace:*",
    "@prisma/adapter-mariadb": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sentry/node": "8.42.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "prisma": "7.8.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.1",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
