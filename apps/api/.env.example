NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://livestock:livestock@localhost:3306/livestock
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# Comma-separated origins allowed to call the API with cookies (dev: the Vite server)
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# File storage: "local" (dev) or "s3" (MinIO / AWS S3 / Cloudflare R2)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=livestock
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

SENTRY_DSN=
